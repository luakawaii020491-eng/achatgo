# AChatGo — file cấu hình mẫu
# Cách dùng: cp .env.example .env rồi điền giá trị thật.
# KHÔNG commit file .env lên Git. Không ghi giá trị thật vào file này.

# Cổng server lắng nghe (Render cấp PORT=10000; chạy local có thể để 3000)
PORT=10000
# Môi trường chạy: development | production
NODE_ENV=production
# Đường dẫn file dữ liệu JSON khi chưa dùng Postgres (mặc định ./data/achatgo.json;
# trên Render dùng /var/data/achatgo.json nhờ disk đính kèm)
DATA_FILE=/var/data/achatgo.json
# Chuỗi kết nối Postgres — khi có biến này server ưu tiên dùng Postgres thay file JSON.
# Lấy ở Render: dashboard database achatgo-db → Connection string (Internal).
DATABASE_URL=
# Chuỗi bí mật ký session/token — tự sinh chuỗi ngẫu nhiên dài, giữ kín, không chia sẻ.
SESSION_SECRET=
# Meta App ID — lấy trong Meta for Developers → ứng dụng của bạn → App ID.
META_APP_ID=
# Meta App Secret — lấy trong Meta for Developers → Cài đặt → Cơ bản → App Secret.
META_APP_SECRET=
# URI callback OAuth Meta — PHẢI đăng ký đúng URI này trong Meta App
# (Đăng nhập Facebook → Cài đặt → Valid OAuth Redirect URIs), nếu không
# đăng nhập Facebook sẽ lỗi. <tenshop> là tên miền riêng của shop.
META_REDIRECT_URI=https://<tenshop>.achat.vn/auth/meta/callback
# Token GHN — lấy trong tài khoản GHN (Giao Hàng Nhanh) → mục API.
GHN_TOKEN=
# Shop ID GHN — lấy trong tài khoản GHN, đi kèm token.
GHN_SHOP_ID=
# Token GHTK — lấy trong tài khoản Giao Hàng Tiết Kiệm → mục API.
GHTK_TOKEN=
# Mã shop GHTK (Shop Code) — lấy trong tài khoản GHTK, đi kèm token.
GHTK_SHOP_CODE=
# Secret Viettel Post (LoginVTP) — lấy trong tài khoản Viettel Post → API.
VTP_SECRET=
# Tài khoản Best Express (API) — tên đăng nhập Best cấp khi ký hợp đồng.
BEST_USERNAME=
# Mật khẩu Best Express (API) — mật khẩu Best cấp khi ký hợp đồng.
BEST_PASSWORD=
# Tài khoản API J&T — J&T cấp sau khi duyệt chứng nhận developer (hiện CHƯA có).
JT_API_ACCOUNT=
# Private key J&T — J&T cấp kèm apiAccount sau khi duyệt (hiện CHƯA có).
JT_PRIVATE_KEY=
# Mã khách hàng J&T — lấy trong hợp đồng J&T.
JT_CUSTOMER_CODE=
# Mật khẩu khách hàng J&T — lấy trong hợp đồng J&T.
JT_CUSTOMER_PASSWORD=
# Pixel ID Facebook — lấy trong Events Manager → Pixel của shop.
CAPI_PIXEL_ID=
# Token Conversions API — lấy trong Events Manager → Pixel → Cài đặt → Conversions API.
CAPI_ACCESS_TOKEN=
# Khóa AI của shop — bấm "Tạo khóa mới" trong mục Super Admin của app (không bịa URL ngoài).
AI_API_KEY=
# TikTok Shop — app CHUNG của cả nền tảng (mô hình Achat): thông tin KHÔNG
# nằm trong .env mà nhập 1 lần duy nhất trong app, đăng nhập Super Admin →
# màn Kênh bán hàng → App TikTok chung. Các shop chỉ bấm "Kết nối TikTok"
# rồi ủy quyền tài khoản seller, không nhập app_key/app_secret/service_id.
# Chỉ URL cần đăng ký trước trong Partner Center (1 Public app):
# Redirect URI: https://achat.vn/auth/tiktok/callback
# Webhook URL: https://achat.vn/webhook/tiktok
# (đăng ký cả hai trong TikTok Shop Partner Center → App & Service → app
# chung → URLs). App Key / App Secret / Service ID lấy trong Partner Center
# → app chung → Basic Information. KHÔNG ghi giá trị thật vào file này hay
# commit lên Git.
# TIKTOK_REDIRECT_URI=https://achat.vn/auth/tiktok/callback
# TIKTOK_WEBHOOK_URL=https://achat.vn/webhook/tiktok
# Shopee — app ISV CHUNG của cả nền tảng (mô hình Achat): thông tin KHÔNG
# nằm trong .env mà nhập 1 lần duy nhất trong app, đăng nhập Super Admin →
# màn Kênh bán hàng → App Shopee chung. Các shop chỉ bấm "Kết nối Shopee"
# rồi ủy quyền tài khoản seller, không nhập partner_id/partner_key.
# Chỉ URL cần đăng ký trước trong console Shopee (1 app Third-Party Partner):
# Redirect URI: https://achat.vn/auth/shopee/callback
# Webhook URL: https://achat.vn/webhook/shopee
# (đăng ký cả hai trong open.shopee.com → app chung → URLs / Push Mechanism).
# Partner ID / Partner Key lấy trong console Shopee → app chung.
# KHÔNG ghi giá trị thật vào file này hay commit lên Git.
# Partner Key hết hạn sau 180 ngày — reset trong console rồi nhập key mới vào app.
# SHOPEE_REDIRECT_URI=https://achat.vn/auth/shopee/callback
# SHOPEE_WEBHOOK_URL=https://achat.vn/webhook/shopee
